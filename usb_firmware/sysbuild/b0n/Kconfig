mainmenu "OpenPendant network recovery bootloader"

# Earlier defaults take priority over the SDK's hash-only CPUNET default.
# Crypto is enabled by SB_CONFIG_SECURE_BOOT_NETCORE_SIGNATURE_TYPE_SOFTWARE.
# bl_validation.c checks this symbol before SB_VALIDATE_FW_HASH and invokes
# validate_signature() for both pre-copy and post-copy validation in netboot.
config SB_VALIDATE_FW_SIGNATURE
	default y if SOC_NRF5340_CPUNET && IS_SECURE_BOOTLOADER

source "Kconfig.zephyr"
